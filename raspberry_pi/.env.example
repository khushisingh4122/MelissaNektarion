# Use the laptop IP address reachable from the Raspberry Pi.
API_BASE_URL=http://192.168.1.100:8000
HARDWARE_API_TOKEN=replace-with-the-same-token-used-by-the-backend
DRONE_ID=1
PIXHAWK_PORT=/dev/ttyACM0
PIXHAWK_BAUD=115200
HARDWARE_POLL_SECONDS=1
LOW_BATTERY_RETURN_HOME=20
MAX_PUMP_SECONDS=30
PUMP_GPIO_PIN=18
REQUIRE_PUMP=true
CAMERA_CAPTURE_DIR=/home/pi/melissanektarion/raspberry_pi/captures
CAMERA_STREAM_WIDTH=640
CAMERA_STREAM_HEIGHT=480
CAMERA_HOST=0.0.0.0
CAMERA_PORT=8081
