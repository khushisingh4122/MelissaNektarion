# Production/Raspberry Pi deployment:
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5711/melissanektarion
MEDIA_RETENTION_DAYS=10
HARDWARE_API_TOKEN=replace-with-a-long-random-device-token
API_BASE_URL=http://127.0.0.1:8000
DRONE_ID=1
PIXHAWK_PORT=/dev/ttyACM0
PIXHAWK_BAUD=115200
HARDWARE_POLL_SECONDS=1
LOW_BATTERY_RETURN_HOME=20
MAX_PUMP_SECONDS=30
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_MODEL=qwen/qwen3.8-27b
